DB_PASSWORD=your_cockroachdb_password
# Bedrock inference profiles and S3. Nova US profiles are invoked from us-east-1.
AWS_REGION=us-east-1
# Host environment only — never commit real keys. Copy this file to .env.local.
# Set both values for an IAM user, or leave them unset and set AWS_USE_IAM_ROLE=1
# so the AWS SDK default chain (task role, instance profile, web identity) is used.
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_USE_IAM_ROLE=1
S3_BUCKET=your-s3-bucket-name
# Amazon Nova Pro US inference profile (credit-eligible). Anthropic / Claude ids are refused.
# Cheaper override: us.amazon.nova-lite-v1:0
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
SSL_CERT_PATH=/home/user/.postgresql/root.crt
# Signed audit ledger: HMAC-SHA256 signing key (falls back to an insecure dev default if unset)
AUDIT_LEDGER_KEY=change-me-to-a-long-random-secret
# Optional: override the ledger file path (default: .audit/incident-ledger.jsonl)
AUDIT_LEDGER_PATH=.audit/incident-ledger.jsonl
# Optional UiPath webhook secret for /api/uipath
UIPATH_WEBHOOK_SECRET=
