# Required for incident API routes. Set this in the Vercel project environment.
# Do not commit a real value. Copy this file to .env.local for local development.
DATABASE_URL=postgresql://user:password@host:26257/defaultdb?sslmode=require
# Bedrock inference profiles and S3. Nova US profiles are invoked from us-east-1.
AWS_REGION=us-east-1
# Host environment only — never commit real keys.
# On Vercel, set AWS_ROLE_ARN to the IAM role that trusts the Vercel OIDC issuer.
# The app then assumes that role with awsCredentialsProvider({ roleArn }).
# AWS_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/vercel-incident-commander-nova
# Static keys are used only when AWS_ROLE_ARN is unset.
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# SDK default chain (task role, instance profile, or a web-identity token file).
# Ignored when AWS_ROLE_ARN is set. Vercel does not set AWS_WEB_IDENTITY_TOKEN_FILE.
# AWS_USE_IAM_ROLE=1
S3_BUCKET=your-s3-bucket-name
# Amazon Nova Pro US inference profile (credit-eligible). Anthropic / Claude ids are refused.
# Cheaper override: us.amazon.nova-lite-v1:0
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
# Signed audit ledger: HMAC-SHA256 signing key (falls back to an insecure dev default if unset)
AUDIT_LEDGER_KEY=change-me-to-a-long-random-secret
# Optional: override the ledger file path (default: .audit/incident-ledger.jsonl)
AUDIT_LEDGER_PATH=.audit/incident-ledger.jsonl
# Optional UiPath webhook secret for /api/uipath
UIPATH_WEBHOOK_SECRET=
